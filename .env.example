# ===========================================================
#  Configuracion de JARVIS Clap
#  Copia este archivo a ".env" y rellena tus valores.
#  En Windows:   copy .env.example .env
# ===========================================================

# Motor de voz: "edge" (gratis, sin API key) o "elevenlabs"
TTS_MOTOR=edge

# --- edge-tts (no necesita API key) ------------------------
EDGE_VOZ=es-ES-AlvaroNeural
EDGE_RATE=-5%
EDGE_PITCH=-15Hz

# --- ElevenLabs (solo si TTS_MOTOR=elevenlabs) -------------
# 1) Crea una cuenta en https://elevenlabs.io
# 2) Disena/clona una voz tipo JARVIS (masculina, grave, en espanol)
# 3) Pega aqui tu API key y el Voice ID de esa voz
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Deteccion del aplauso ---------------------------------
# Sensibilidad 0.0 - 1.0 (sube si se dispara solo, baja si no te detecta)
UMBRAL_APLAUSO=0.30
# Segundos de pausa tras cada reaccion
ENFRIAMIENTO=3.0
